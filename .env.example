# Build-time variables. None are secrets. Copy to .env for local overrides.
# Cloudflare Pages sets CF_PAGES_* itself; set the others under
# Settings > Variables and Secrets of the Pages project only if the default
# does not fit.

# "production" or "preview". Overrides branch detection. Leave unset on
# Cloudflare Pages. Locally, unset means "preview" (noindexed, /_parity/ built).
SITE_ENV=

# Set by Cloudflare Pages to the branch being built. A build is production
# only when this equals PRODUCTION_BRANCH. Do not set it yourself.
CF_PAGES_BRANCH=

# The branch Cloudflare Pages deploys to production. Default: main.
PRODUCTION_BRANCH=main

# Used only by `pnpm check-redirects` (scripts/crawl/verify-parity.mjs):
# the base URL to check legacy URLs against. Default: the live site.
PARITY_BASE=
